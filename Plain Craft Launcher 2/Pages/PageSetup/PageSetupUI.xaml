<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupUI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="基础" x:Name="CardLauncher">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherTransparent" 
                                            MaxValue="600" ValueByKey="10" Grid.ColumnSpan="5" x:Name="SliderLauncherTransparent" Grid.Column="1" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Name="LabLauncherHue" Visibility="Visible" HorizontalAlignment="Left" Text="色调" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherHue"
                                            Grid.Row="1" Grid.Column="1" x:Name="SliderLauncherHue" Visibility="Visible" MaxValue="360" ValueByKey="10" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Name="LabLauncherDelta" Visibility="Visible" HorizontalAlignment="Left" Text="色调渐变" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherDelta"
                                            Grid.Row="2" Grid.Column="1" x:Name="SliderLauncherDelta" Visibility="Visible" MaxValue="180" ValueByKey="5" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherSat" Visibility="Visible" HorizontalAlignment="Left" Text="饱和度" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherSat"
                                            Grid.Row="1" Grid.Column="4" x:Name="SliderLauncherSat" Visibility="Visible" MaxValue="100" ValueByKey="5" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherLight" Visibility="Visible" HorizontalAlignment="Left" Text="亮度" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherLight"
                                            Grid.Row="2" Grid.Column="4" x:Name="SliderLauncherLight" Visibility="Visible" MaxValue="40" ValueByKey="5" Margin="0,10,0,0" />
                        </Grid>
                        <Grid x:Name="PanLauncherTheme" Height="90" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="主题" Margin="0,0,20,0" />
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="隐藏主题" Margin="0,0,20,0" Grid.Row="1" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="0" 
                                              Grid.Column="1" Grid.Row="0" Text="海洋蓝" x:Name="RadioLauncherTheme0" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="1" 
                                              Grid.Column="2" Grid.Row="0" Text="甜柠青" x:Name="RadioLauncherTheme1" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="2" 
                                              Grid.Column="3" Grid.Row="0" Text="小草绿" x:Name="RadioLauncherTheme2" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="3" 
                                              Grid.Column="4" Grid.Row="0" Text="菠萝黄" x:Name="RadioLauncherTheme3" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="4" 
                                              Grid.Column="5" Grid.Row="0" Text="橡木棕" x:Name="RadioLauncherTheme4" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="5" 
                                              Grid.Column="1" Grid.Row="1" Text="玄素黑" x:Name="RadioLauncherTheme5" Opacity="0" ToolTip="灰色是个谎言" Visibility="Collapsed" />
                            <local:MyRadioBox Grid.Column="1" Grid.Row="1" Text="玄素黑" x:Name="RadioLauncherTheme5Gray" Opacity="1" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="LabLauncherTheme5Unlock" Background="{StaticResource ColorBrushSemiTransparent}" ToolTip="灰色是个谎言" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="12"
                                              Grid.Column="2" Grid.Row="1" Text="滑稽彩" x:Name="RadioLauncherTheme12" ToolTip="滑稽树上滑稽果，滑稽树下你和我，滑稽之日搞事情，欢乐多又多" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="6"
                                              Grid.Column="3" Grid.Row="1" Text="铁杆粉" x:Name="RadioLauncherTheme6" ToolTip="99 次重逢的喜悦" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="7"
                                              Grid.Column="4" Grid.Row="1" Text="神秘紫" x:Name="RadioLauncherTheme7" ToolTip="072 101 108 112 032 068 101 118 032 048 046 052 046 052" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="13"
                                              Grid.Column="5" Grid.Row="1" Text="欧皇彩" x:Name="RadioLauncherTheme13" ToolTip="这就是传说中的欧皇了吧" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="8"
                                              Grid.Column="1" Grid.Row="2" Text="秋仪金" x:Name="RadioLauncherTheme8" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Grid.Row="2" x:Name="LabLauncherTheme8Copy" Background="{StaticResource ColorBrushSemiTransparent}" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="9"
                                              Grid.Column="2" Grid.Row="2" Text="活跃橙" x:Name="RadioLauncherTheme9" Visibility="Collapsed" />
                            <TextBlock Grid.Column="2" Grid.Row="2" x:Name="LabLauncherTheme9Copy" Background="{StaticResource ColorBrushSemiTransparent}" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="10"
                                              Grid.Column="3" Grid.Row="2" Text="跳票红" x:Name="RadioLauncherTheme10" ToolTip="进行一次正版登录，支持正版游戏！" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="11"
                                              Grid.Column="4" Grid.Row="2" Text="极客蓝" x:Name="RadioLauncherTheme11" ToolTip="右键打开解密游戏入口" Visibility="Collapsed" />
                            <TextBlock Grid.Column="4" Grid.Row="2" x:Name="LabLauncherTheme11Click" Background="{StaticResource ColorBrushSemiTransparent}" Visibility="Collapsed" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="14"
                                              Grid.Column="5" Grid.Row="2" Text="自定义" x:Name="RadioLauncherTheme14" ToolTip="自由定义你的专属配色方案！" />
                        </Grid>
                        <local:MyCheckBox local:SettingService.Key="UiLauncherLogo" Text="打开启动器时显示 WCL 图标" Margin="-1,0,0,1" Height="22" />
                    </StackPanel>
                    <Border Background="#DDDDDDDD" Margin="-8,23,-5,28" CornerRadius="4" Name="PanLauncherHide" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="如果可以小小赞助一下 WCL，就能解锁主题颜色更换功能啦……&#xa;多亏了大家的支持，WCL 才能在免费、无任何广告的情况下维持数年的更新（磕头）！" FontSize="13" Margin="0,0,0,0" />
                            <local:MyButton Height="32" MinWidth="140" Text="支持 WCL 开发！" Padding="13,0" HorizontalAlignment="Center" Margin="0,9,0,0" ColorType="Highlight"
                                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://meloong.com/afd/a/LTCat" />
                        </StackPanel>
                    </Border>
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardBackground" Margin="0,0,0,15" Title="背景图片">
                <StackPanel Margin="25,40,25,20">
                    <Grid Height="28" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="壁纸来源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBackgroundSource" local:SettingService.Key="UiBackgroundSource" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="内置默认壁纸 (日间 / 夜间)" ToolTip="使用启动器内置的日间与夜间壁纸，按当前日夜模式显示对应的那一张。" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="自定义壁纸文件夹" ToolTip="随机加载 PCL\Pictures 中的图片；文件夹为空时自动回退到内置壁纸。" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="不使用壁纸" ToolTip="只显示主题色背景，不加载任何图片。" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="日夜模式" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboThemeMode" local:SettingService.Key="UiThemeMode" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="跟随时间自动切换" ToolTip="到达设定的时间点后自动在日间与夜间之间切换。" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="始终日间模式" ToolTip="固定使用日间壁纸，不受时间影响。" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="始终夜间模式" ToolTip="固定使用夜间壁纸，不受时间影响。" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanDayNightTime" Height="28" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="切换时间" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDayStart" local:SettingService.Key="UiDayStart" Width="88" Grid.Column="1" ToolTip="从该时刻开始进入日间模式。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="至" Margin="8,0,8,0" Grid.Column="2" />
                        <local:MyComboBox x:Name="ComboNightStart" local:SettingService.Key="UiNightStart" Width="88" Grid.Column="3" HorizontalAlignment="Left" ToolTip="从该时刻开始进入夜间模式。" />
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="更换方式" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBackgroundSwitch" local:SettingService.Key="UiBackgroundSwitch" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="按时间段自动更换" ToolTip="跟随日夜模式，在日间与夜间壁纸之间自动切换。" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="自动随机" ToolTip="每次加载背景时随机抽取一张壁纸。" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="手动固定" ToolTip="只在点击「更换壁纸」时切换，其余时候保持不变。" />
                        </local:MyComboBox>
                    </Grid>
                    <local:MyCheckBox x:Name="CheckThemeDark" local:SettingService.Key="UiThemeDark" Text="夜间使用深色主题" Margin="-1,0,0,6" Height="22"
                                      ToolTip="夜间模式下把界面切换为深色配色，与夜间壁纸配合使用；日间模式始终使用浅色主题。" />
                    <TextBlock x:Name="LabDayNightStatus" VerticalAlignment="Center" HorizontalAlignment="Left" Text="尚未获取当前模式"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip="当前生效的日夜模式，由时间与手动设置共同决定。" />
                    <TextBlock x:Name="LabBackgroundStatus" VerticalAlignment="Center" HorizontalAlignment="Left" Text="正在加载壁纸信息……"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10" ToolTip="当前正在使用的壁纸来源。" />
                    <Grid x:Name="PanBackgroundSuit" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自适应方式" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundSuit" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="自动" ToolTip="当图片较小时选择平铺，较大时选择居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="平铺" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="居中" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="拉伸" ToolTip="拉伸图片使其恰好填满整个窗口，很可能会导致长宽比的改变" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="左上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="左中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="左下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="中上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="中下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="右上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="右中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="8" Content="右下 (保持长宽比)" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundOpacity" Height="22" Margin="0,0,0,7" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundOpacity" x:Name="SliderBackgroundOpacity" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanBackgroundBlur" Height="22" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="背景模糊" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundBlur" x:Name="SliderBackgroundBlur" MaxValue="40" Grid.Column="1" 
                                        ToolTip="高度的模糊会严重掉帧，请谨慎。&#13;不建议在制作整合包时开启模糊，以确保 WCL 在低性能电脑上可以流畅运行。" />
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiBackgroundColorful" Text="叠加彩色背景" Margin="-1,0,0,8" Height="22" />
                    <Grid Height="35" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnBackgroundNext" MinWidth="140" Text="更换壁纸" Padding="13,0" Margin="0,0,20,0" Visibility="Collapsed"
                                        ToolTip="手动切换到下一张壁纸。" />
                        <local:MyButton x:Name="BtnBackgroundOpen" MinWidth="140" Text="打开文件夹" Padding="13,0" Margin="0,0,20,0" Grid.Column="1"
                                        ToolTip="将背景图片放到该文件夹，WCL 将会在每次打开时随机加载其中的一张图片"/>
                        <local:MyButton x:Name="BtnBackgroundRefresh" MinWidth="140" Text="刷新背景图片" Padding="13,0" Margin="0,0,20,0" Grid.Column="2"
                                        ToolTip="随机加载文件夹内的一张背景图片"/>
                        <local:MyButton x:Name="BtnBackgroundClear" MinWidth="140" Text="清空背景图片" Visibility="Collapsed" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="3"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardGlass" Margin="0,0,0,15" Title="磨砂玻璃">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox local:SettingService.Key="UiGlass" x:Name="CheckGlass" Text="启用磨砂玻璃效果" Margin="-1,0,0,8" Height="22"
                                      ToolTip="将内容区变为磨砂玻璃，透出启动器背景图片并叠加主题色调，同时让卡片略微通透。&#13;未设置背景图片时使用主题色背景。&#13;关闭后恢复为普通的纯色背景。" />
                    <Grid x:Name="PanGlassDetail" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="天气效果" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiGlassWeather" x:Name="ComboGlassWeather" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="自动 (按本地天气)" ToolTip="联网查询本地天气，默认按 IP 定位，也可在下方填写城市以精确到城市；查询失败时按多云显示" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="晴天" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="多云" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="下雨" ToolTip="玻璃外侧的雨丝与挂在玻璃上的水珠，水珠会不断合并并滚落" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="下雪" ToolTip="窗沿积雪与缓缓飘落的雪花" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="染色强度" Margin="0,0,25,0" Grid.Row="1" />
                        <local:MySlider local:SettingService.Key="UiGlassOpacity" x:Name="SliderGlassOpacity" MaxValue="1000" ValueByKey="10" Grid.Column="1" Grid.Row="1"
                                        ToolTip="控制磨砂玻璃上主题色调的浓淡，调低会更接近原始背景。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="粒子浓度" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MySlider local:SettingService.Key="UiGlassParticle" x:Name="SliderGlassParticle" MaxValue="1000" ValueByKey="10" Grid.Column="1" Grid.Row="2"
                                        ToolTip="控制雨丝、雪花、光尘与云影的数量，调低可以降低性能占用。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="阳光反射" Margin="0,0,25,0" Grid.Row="3" />
                        <local:MySlider local:SettingService.Key="UiGlassSunbeam" x:Name="SliderGlassSunbeam" MaxValue="1000" ValueByKey="10" Grid.Column="1" Grid.Row="3"
                                        ToolTip="控制晴天时玻璃上斜射光带与高光反射的强度，仅在晴天生效。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="动效速度" Margin="0,0,25,0" Grid.Row="4" />
                        <local:MySlider local:SettingService.Key="UiGlassSpeed" x:Name="SliderGlassSpeed" MaxValue="1000" ValueByKey="10" Grid.Column="1" Grid.Row="4"
                                        ToolTip="控制天气粒子的下落与漂移速度。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="城市" Margin="0,0,25,0" Grid.Row="5" />
                        <local:MyTextBox x:Name="TextGlassCity" local:SettingService.Key="UiGlassWeatherCity" Grid.Column="1" Grid.Row="5" MaxHeight="28"
                                         ToolTip="填写城市名（如 杭州、Tokyo）后，会按该城市精确获取天气，而不是按 IP 粗略定位。&#xa;留空时按 IP 自动定位，定位可能不准确。" 
                                         HintText="留空则按 IP 自动定位" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="墨迹天气 AppCode" Margin="0,0,25,0" Grid.Row="6" />
                        <local:MyTextBox x:Name="TextGlassMojiCode" local:SettingService.Key="UiGlassMojiCode" Grid.Column="1" Grid.Row="6" MaxHeight="28"
