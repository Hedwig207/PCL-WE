<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherJukebox"
    PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,15,25,10">
                <local:MyCard x:Name="CardNow" Margin="0,0,0,15" Title="正在播放">
                    <StackPanel Margin="21,40,21,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6" ClipToBounds="True">
                                <local:MyImage x:Name="ImgNow" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LabNowTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="尚未播放" />
                                <TextBlock x:Name="LabNowInfo" Margin="0,5,0,0" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                           Text="在下方列表中选择一张唱片开始播放" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MyIconButton x:Name="BtnPrev" ToolTip="上一曲" LogoScale="0.75" Height="32" Width="32" />
                                <local:MyIconButton x:Name="BtnToggle" ToolTip="播放" LogoScale="0.75" Height="32" Width="32" Margin="5,0" />
                                <local:MyIconButton x:Name="BtnNext" ToolTip="下一曲" LogoScale="0.75" Height="32" Width="32" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MySlider x:Name="SliderProgress" Grid.Column="0" MaxValue="1000" Height="24" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabTime" Grid.Column="1" Margin="12,0,0,0" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Text="0:00 / 0:00" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="PanMode" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MyRadioButton Tag="0" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="随机播放" x:Name="BtnModeRandom" />
                                <local:MyRadioButton Tag="1" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="列表播放" x:Name="BtnModeList" />
                                <local:MyRadioButton Tag="2" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="循环播放" x:Name="BtnModeLoop" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="音量" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <local:MySlider x:Name="SliderVolume" Width="110" MaxValue="1000" Height="24" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MySearchBox x:Name="SearchBox" Margin="0,0,0,15" HintText="搜索唱片名称" />

                <local:MyCard x:Name="CardList" Margin="0,0,0,15" Title="唱片列表">
                    <StackPanel Margin="10,40,10,10">
                        <Grid Margin="11,0,11,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="PanFilter" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MyRadioButton Tag="0" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="全部" x:Name="BtnFilterAll" Checked="True" />
                                <local:MyRadioButton Tag="1" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="内置唱片" x:Name="BtnFilterBuiltin" />
                                <local:MyRadioButton Tag="2" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Text="自定义" x:Name="BtnFilterCustom" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MyButton x:Name="BtnImport" Height="30" Padding="18,0" Text="导入歌曲" ColorType="Highlight" />
                                <local:MyButton x:Name="BtnRefresh" Height="30" Padding="18,0" Margin="8,0,0,0" Text="刷新" ColorType="Normal" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="PanList" />
                        <StackPanel x:Name="PanEmpty" Visibility="Collapsed" Margin="11,10,11,10">
                            <TextBlock x:Name="LabEmptyTitle" FontSize="14" HorizontalAlignment="Center" Text="没有找到任何唱片" />
                            <TextBlock x:Name="LabEmptyInfo" Margin="0,8,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center" Text="请点击「导入歌曲」，或将音乐放入 musicassets\music 目录" />
                            <local:MyButton x:Name="BtnOpenFolder" HorizontalAlignment="Center" Margin="0,12,0,0" Height="28" Padding="16,0"
                                            Text="打开音乐目录" ColorType="Normal" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>